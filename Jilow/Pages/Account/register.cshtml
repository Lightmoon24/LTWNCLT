@page
@model RegisterModel

@{
    Layout = "_AuthmeLayout";
    ViewData["Title"] = "Register";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Register.css"
          asp-append-version="true" />
}

<div class="Register-Body">

    <div class="Register-main-container">

        <div class="Register-Header">
            <h2 class="Register-Header-logo">
                Jilow
            </h2>

            <p class="Register-Header-title">
                Đăng ký tài khoản
            </p>
        </div>

        <form method="post">

            <div class="Register-Form">

                <label class="Register-Form-label">
                    Email
                </label>

                <input asp-for="Email"
                       type="email"
                       class="Register-Form-input"
                       placeholder="Nhập email của bạn" />

                <label class="Register-Form-label">
                    Password
                </label>

                <input asp-for="Password"
                       type="password"
                       class="Register-Form-input"
                       placeholder="Nhập mật khẩu của bạn" />

                <label class="Register-Form-label">
                    Confirm Password
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       class="Register-Form-input"
                       placeholder="Nhập lại mật khẩu của bạn" />

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <span class="Register-ErrorMessage">
                        @Model.ErrorMessage
                    </span>
                }

                <div class="Register-register-btn">
                    <button type="submit">
                        Đăng Ký
                    </button>
                </div>

            </div>

        </form>

        <div class="Register-Footer-text">
            <a asp-page="/Account/Login">
                Bạn đã có tài khoản? Đăng nhập ngay
            </a>
        </div>

    </div>

</div>