@page
@model LoginModel

@{
    Layout = "_AuthmeLayout";
    ViewData["Title"] = "Login";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Login.css"
          asp-append-version="true" />
}

<div class="Login-Body">

    <div class="Login-main-container">

        <div class="Login-Header">
            <h2 class="Login-Header-logo">
                Jilow
            </h2>

            <p class="Login-Header-title">
                Đăng nhập để tiếp tục
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="Login-SuccessMessage">
                @Model.SuccessMessage
            </div>
        }

        <form method="post">

            <div class="Login-Form">

                <label class="Login-Form-label">
                    Email
                </label>

                <input asp-for="Email"
                       type="email"
                       class="Login-Form-input"
                       placeholder="Nhập email của bạn" />

                <label class="Login-Form-label">
                    Password
                </label>

                <input asp-for="Password"
                       type="password"
                       class="Login-Form-input"
                       placeholder="Nhập mật khẩu của bạn" />

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <span class="Login-ErrorMessage">
                        @Model.ErrorMessage
                    </span>
                }

                <div class="Login-login-btn">
                    <button type="submit">
                        Đăng nhập
                    </button>
                </div>

            </div>

        </form>

        <div class="Login-ForgetPassword-text">
            <a asp-page="/Account/Login">
                Bạn không đăng nhập được?
            </a>

            •

            <a asp-page="/Account/Register">
                Tạo tài khoản
            </a>
        </div>

    </div>

</div>